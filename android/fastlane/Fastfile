default_platform(:android)

platform :android do

  desc "Build release AAB"
  lane :build do
    Dir.chdir("../..") do
      sh("flutter build appbundle --release")
    end
  end

  desc "Deploy to Play Store Internal track"
  lane :deploy_internal do
    build
    upload_to_play_store(
      track: "internal",
      aab: "../../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_STORE_JSON_KEY_DATA"]
    )
  end

  desc "Promote Internal to Beta"
  lane :promote_beta do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "beta",
      json_key_data: ENV["PLAY_STORE_JSON_KEY_DATA"]
    )
  end

  desc "Promote Beta to Production"
  lane :promote_production do
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      json_key_data: ENV["PLAY_STORE_JSON_KEY_DATA"]
    )
  end


  desc "Build do AAB de release com o numero de versao informado pelo CI (BUILD_NUMBER)"
  lane :build_release do
    build_number = ENV["BUILD_NUMBER"].to_s
    UI.user_error!("BUILD_NUMBER obrigatorio") if build_number.empty?
    Dir.chdir("../..") do
      sh("flutter build appbundle --release --build-number=#{build_number}")
    end
  end

  desc "Teste fechado (faixa alpha) - branch desenv"
  lane :teste_fechado do
    build_release
    upload_to_play_store(
      track: "alpha",
      release_status: "completed",
      aab: "../../build/app/outputs/bundle/release/app-release.aab",
      json_key: "fastlane/google-play-key.json"
    )
  end

  desc "Teste aberto (faixa beta) - branch main"
  lane :teste_aberto do
    build_release
    upload_to_play_store(
      track: "beta",
      release_status: "completed",
      aab: "../../build/app/outputs/bundle/release/app-release.aab",
      json_key: "fastlane/google-play-key.json"
    )
  end

end
